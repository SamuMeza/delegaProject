# Variables de entorno públicas (prefijo BUN_PUBLIC_ requerido por Bun.build).
# Estas variables se incluyen en el bundle del cliente (SPA sin backend).
# Los hashes son SHA-256 de la contraseña, generados localmente. Nunca guardar
# la contraseña en texto plano. Ver manual técnico §3 y §10.

# Activa/desactiva el panel administrativo.
BUN_PUBLIC_ADMIN_PANEL_ENABLED=true

# Operador 1
BUN_PUBLIC_OPERATOR_1_NAME=TuNombre
BUN_PUBLIC_OPERATOR_1_USER=tu_usuario
BUN_PUBLIC_OPERATOR_1_PASS_HASH=5e884898da28047151d0e56f8dc6292773603d0d6aabbdd62a11ef721d1542d8

# Operador 2
BUN_PUBLIC_OPERATOR_2_NAME=Socio
BUN_PUBLIC_OPERATOR_2_USER=socio_usuario
BUN_PUBLIC_OPERATOR_2_PASS_HASH=hash_sha256_aqui

# Número de WhatsApp destino (formato internacional sin +, ej: 584121234567)
BUN_PUBLIC_WHATSAPP_NUMBER=584121234567
